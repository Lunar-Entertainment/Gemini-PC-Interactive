# Google Gemini API Key (Get yours from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Server configuration
HOST=127.0.0.1
PORT=8080

# Default model: gemini-2.5-flash or gemini-2.5-pro or gemini-2.0-flash
DEFAULT_MODEL=gemini-2.5-flash

# Maximum automated steps per task
MAX_AGENT_STEPS=30

# Visual coordinate grid overlay on screenshots for precise visual grounding
GRID_OVERLAY=true

# Delay in seconds between automated actions (for safety and smooth animation)
ACTION_DELAY_SEC=0.6

# Require manual step-by-step confirmation by default
REQUIRE_CONFIRMATION=false
